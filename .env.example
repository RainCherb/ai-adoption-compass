# Все переменные необязательны. Скопируйте в .env при необходимости.

# Файл базы SQLite (по умолчанию ./compass.db)
COMPASS_DB=compass.db

# Папка с собственными YAML-файлами данных (catalog.yaml, policy.yaml, scoring.yaml, prompts.yaml, evals/*):
# файлы из этой папки переопределяют встроенные.
# COMPASS_DATA_DIR=./my-data

# Курс USD/RUB для расчёта стоимости зарубежных моделей
# COMPASS_USD_RUB=90

# Папка, доступная файловым инструментам MCP-сервера (по умолчанию — текущая)
# COMPASS_MCP_ROOT=.

# Зафиксировать «сегодня» для воспроизводимых проверок свежести каталога (ГГГГ-ММ-ДД)
# COMPASS_TODAY=2026-10-24

# Ключ для `compass eval run -p api` (имя переменной задаётся опцией --api-key-env)
# OPENAI_API_KEY=
